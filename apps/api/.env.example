# SayyaraDMS API — copy to .env and adjust.
# Non-secret local defaults are filled in; secrets are left blank and never committed.
ENVIRONMENT=development

# FastAPI connects as the dedicated app_api role (never service_role). D-08.
# Local password is set by supabase/seed.sql; production password lives in the secret manager.
DATABASE_URL=postgresql://app_api:app_api_local_dev@127.0.0.1:54322/postgres

SUPABASE_URL=http://127.0.0.1:54321
# Optional; defaults to {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=
# Only for legacy HS256 projects. Leave empty when the project uses JWT signing keys.
# SUPABASE_JWT_SECRET=

# Server-side only (invites, storage signed URLs). NEVER put this in the Angular app or in git.
# Locally it is filled from the running stack by `scripts/dev.ps1 env` / `make env` (supabase status).
SUPABASE_SERVICE_ROLE_KEY=

CORS_ORIGINS=["http://localhost:4200", "http://127.0.0.1:4200"]
INVITE_REDIRECT_URL=http://localhost:4200/reset-password

# Integration tests only
TEST_ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
